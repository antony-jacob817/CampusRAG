# AI Services
# Primary: Google Gemini API Key
GEMINI_API_KEY=
# Fallback: OpenRouter API Key
OPENROUTER_API_KEY=

# Vector Database (Pinecone Serverless, with automatic in-memory Cosine Similarity fallback)
PINECONE_API_KEY=
PINECONE_INDEX=quickstart
PINECONE_ENVIRONMENT=us-east-1
